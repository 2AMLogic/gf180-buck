v {xschem version=3.4.7 file_version=1.2
* compensator symbol: type-III network around the error amplifier
* Pin order == the .subckt pin order of the netlisted block.
}
G {}
K {type=subcircuit
format="@name @pinlist compensator"
template="name=x1"
}
V {}
S {}
E {}
L 4 -80 -120 80 -120 {}
L 4 -80 120 80 120 {}
L 4 -80 -120 -80 120 {}
L 4 80 -120 80 120 {}
B 5 -82 -102 -78 -98 {name=VOUT dir=in pinnumber=1}
T {VOUT} -72 -104 0 0 0.2 0.2 {}
B 5 -82 -62 -78 -58 {name=VREF dir=in pinnumber=2}
T {VREF} -72 -64 0 0 0.2 0.2 {}
B 5 -82 -22 -78 -18 {name=IBIAS dir=in pinnumber=3}
T {IBIAS} -72 -24 0 0 0.2 0.2 {}
B 5 78 -102 82 -98 {name=VC dir=out pinnumber=4}
T {VC} 72 -104 0 1 0.2 0.2 {}
B 5 -82 18 -78 22 {name=VDD33 dir=inout pinnumber=5}
T {VDD33} -72 16 0 0 0.2 0.2 {}
B 5 -82 58 -78 62 {name=GND dir=inout pinnumber=6}
T {GND} -72 56 0 0 0.2 0.2 {}
T {@name} -80 -130 0 0 0.25 0.25 {}
T {compensator} -80 130 0 0 0.25 0.25 {}
