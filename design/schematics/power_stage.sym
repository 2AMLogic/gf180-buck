v {xschem version=3.4.7 file_version=1.2
* power_stage symbol: on-die power switches (#33)
* Pin order == the .subckt pin order of the netlisted block.
}
G {}
K {type=subcircuit
format="@name @pinlist power_stage"
template="name=x1"
}
V {}
S {}
E {}
L 4 -80 -120 80 -120 {}
L 4 -80 120 80 120 {}
L 4 -80 -120 -80 120 {}
L 4 80 -120 80 120 {}
B 5 -82 -102 -78 -98 {name=GH dir=in pinnumber=1}
T {GH} -72 -104 0 0 0.2 0.2 {}
B 5 -82 -62 -78 -58 {name=GL dir=in pinnumber=2}
T {GL} -72 -64 0 0 0.2 0.2 {}
B 5 -82 -22 -78 -18 {name=VIN dir=inout pinnumber=3}
T {VIN} -72 -24 0 0 0.2 0.2 {}
B 5 -82 18 -78 22 {name=SW dir=inout pinnumber=4}
T {SW} -72 16 0 0 0.2 0.2 {}
B 5 -82 58 -78 62 {name=GND dir=inout pinnumber=5}
T {GND} -72 56 0 0 0.2 0.2 {}
T {@name} -80 -130 0 0 0.25 0.25 {}
T {power_stage} -80 130 0 0 0.25 0.25 {}
