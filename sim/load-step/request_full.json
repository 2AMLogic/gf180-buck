{
 "netlist": "bench.spice",
 "engine": "ngspice",
 "models": {
  "pdk": "gf180mcuD",
  "lib": "libs.tech/ngspice/sm141064.ngspice"
 },
 "analysis": {
  "kind": "tran",
  "args": "2.5n 760u 480u 2.5n"
 },
 "corners": {
  "process": [
   {
    "name": "typical",
    "sections": [
     "typical",
     "mimcap_typical",
     "cap_mim",
     "res_typical"
    ]
   },
   {
    "name": "ff",
    "sections": [
     "ff",
     "mimcap_ff",
     "cap_mim",
     "res_ff"
    ]
   },
   {
    "name": "ss",
    "sections": [
     "ss",
     "mimcap_ss",
     "cap_mim",
     "res_ss"
    ]
   },
   {
    "name": "fs",
    "sections": [
     "fs",
     "mimcap_typical",
     "cap_mim",
     "res_typical"
    ]
   },
   {
    "name": "sf",
    "sections": [
     "sf",
     "mimcap_typical",
     "cap_mim",
     "res_typical"
    ]
   }
  ],
  "supply_v": {
   "vsrc": [
    4.5,
    5.0,
    5.5
   ]
  },
  "supply_waveforms": [
   "vsrc"
  ],
  "temperature_c": [
   -40,
   27,
   125
  ],
  "params": {
   "lfac": [
    0.8,
    1.2
   ],
   "c_out": [
    4.7e-06,
    4.7e-06
   ],
   "esr": [
    0.01,
    0.01
   ]
  }
 },
 "measurements": [
  {
   "name": "vout_last",
   "spice": ".meas tran vout_last FIND v(out) AT=759u",
   "unit": "V"
  }
 ],
 "batch": {
  "max_units_per_job": 1,
  "max_concurrent_jobs": 12
 },
 "options": {
  "keep_artifacts": true,
  "waveforms": true,
  "timeout_s": 1200,
  "threads_per_worker": 1,
  "save_vectors": [
   "v(out)",
   "i(lind)",
   "v(sw_d)",
   "v(vsrc)",
   "i(vsrc)"
  ]
 }
}
