{
 "netlist": "bench.spice",
 "engine": "ngspice",
 "models": {
  "pdk": "gf180mcuD",
  "lib": "libs.tech/ngspice/sm141064.ngspice"
 },
 "analysis": {
  "kind": "tran",
  "args": "2.5n 260u 20u 2.5n"
 },
 "corners": {
  "process": [
   {
    "name": "typical",
    "sections": [
     "typical",
     "mimcap_typical",
     "cap_mim",
     "res_typical"
    ]
   }
  ],
  "supply_v": {
   "vsrc": [
    5.0
   ]
  },
  "supply_waveforms": [
   "vsrc"
  ],
  "temperature_c": [
   27
  ],
  "params": {
   "rload": [
    1000000000.0
   ],
   "c_wind": [
    5e-14
   ]
  }
 },
 "measurements": [
  {
   "name": "vout_last",
   "spice": ".meas tran vout_last FIND v(out) AT=259u",
   "unit": "V"
  },
  {
   "name": "vc_max",
   "spice": ".meas tran vc_max MAX v(vc) FROM=180u TO=260u",
   "unit": "V"
  },
  {
   "name": "vc_min",
   "spice": ".meas tran vc_min MIN v(vc) FROM=180u TO=260u",
   "unit": "V"
  },
  {
   "name": "out_max",
   "spice": ".meas tran out_max MAX v(out) FROM=180u TO=260u",
   "unit": "V"
  },
  {
   "name": "out_min",
   "spice": ".meas tran out_min MIN v(out) FROM=180u TO=260u",
   "unit": "V"
  }
 ],
 "batch": {
  "max_units_per_job": 1,
  "max_concurrent_jobs": 12
 },
 "options": {
  "keep_artifacts": true,
  "waveforms": true,
  "timeout_s": 900,
  "threads_per_worker": 1,
  "save_vectors": [
   "v(out)",
   "i(lind)",
   "v(sw_d)",
   "v(vc)",
   "v(pwm)",
   "v(xtop.xcomp.fbn)",
   "v(xtop.trip)",
   "v(xtop.clk)",
   "v(xtop.ramp)",
   "v(vref_ss)",
   "v(xtop.vref)"
  ]
 }
}