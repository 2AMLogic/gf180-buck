{
 "netlist": "bench.spice",
 "engine": "ngspice",
 "models": {
  "pdk": "gf180mcuD",
  "lib": "libs.tech/ngspice/sm141064.ngspice"
 },
 "analysis": {
  "kind": "tran",
  "args": "2.5n 700u 400u 2.5n"
 },
 "corners": {
  "process": [
   {
    "name": "typical",
    "sections": [
     "typical",
     "mimcap_typical",
     "cap_mim",
     "res_typical"
    ]
   }
  ],
  "supply_v": {
   "vsrc": [
    5.0
   ]
  },
  "supply_waveforms": [
   "vsrc"
  ],
  "temperature_c": [
   27
  ],
  "params": {
   "rload": [
    1000000000.0
   ]
  }
 },
 "measurements": [
  {
   "name": "vout_last",
   "spice": ".meas tran vout_last FIND v(out) AT=699u",
   "unit": "V"
  }
 ],
 "batch": {
  "max_units_per_job": 1,
  "max_concurrent_jobs": 12
 },
 "options": {
  "keep_artifacts": true,
  "waveforms": true,
  "timeout_s": 1200,
  "threads_per_worker": 1,
  "save_vectors": [
   "v(out)",
   "v(gnd_d)",
   "v(vc)",
   "v(pwm)",
   "i(lind)"
  ]
 }
}