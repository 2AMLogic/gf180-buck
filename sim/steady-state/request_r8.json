    "vsrc": 4.5
   },
   "params": {
    "lfac": 1.0
   }
  },
  {
   "supply_v": {
    "vsrc": 5.0
   },
   "params": {
    "lfac": 0.8
   }
  },
  {
   "supply_v": {
    "vsrc": 5.0
   },
   "params": {
    "lfac": 1.2
   }
  },
  {
   "supply_v": {
    "vsrc": 5.5
   },
   "params": {
    "lfac": 1.0
   }
  },
  {
   "supply_v": {
    "vsrc": 5.5
   },
   "params": {
    "lfac": 1.2
   }
  }
 ]
